# Supabase (Project settings -> API). Service role key is SERVER ONLY - never expose it.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Random 32+ char string used to sign the admin session cookie
SESSION_SECRET=

# Optional: lets a new student set the launcher up on their own phone (appears as "pending" in the panel).
# Leave empty to disable; students then need a pairing code from you.
ENROLL_CODE=

# SMTP for password-reset e-mails (reset codes go to each student's guardian e-mail, never the student).
# Gmail: smtp.gmail.com, port 587, user = your address, pass = an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Study Launcher <you@example.com>
